# Vendors allowed into Pricing: email:access-code pairs, separated by commas.
# Codes are compared as digits only, so 1234-5678 and 12345678 are the same code.
VENDOR_ACCESS=buyer@example.com:1234-5678

# Signs the vendor session cookie. Any long random string; required in production.
VENDOR_SESSION_SECRET=change-me-to-a-long-random-string
